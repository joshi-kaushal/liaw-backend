# Database
POSTGRES_USER=liaw
POSTGRES_PASSWORD=liaw_dev_pass
POSTGRES_DB=liaw
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://liaw:liaw_dev_pass@db:5432/liaw

# JWT
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8760

# Odyssey Gateway — WhatsApp routing via Baileys
ODYSSEY_URL=http://odyssey:3000           # docker-compose service name, or Railway URL in prod
ODYSSEY_API_KEY=your_gateway_api_key      # must match GATEWAY_API_KEY in Odyssey env
ODYSSEY_WEBHOOK_SECRET=your_webhook_secret # must match webhook_secret in Odyssey config.json

# Meta / WhatsApp Cloud API — no longer used; replaced by Odyssey.
# META_PHONE_NUMBER_ID=your-phone-number-id
# META_ACCESS_TOKEN=your-access-token
# META_VERIFY_TOKEN=your-webhook-verify-token
# META_APP_SECRET=your-app-secret

# PgAdmin (local dev only)
PGADMIN_EMAIL=admin@liaw.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=["chrome-extension://your-extension-id","http://localhost:5173"]
